# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=5000
DATABASE_URL="YOUR_NEON_POSTGRESQL_CONNECTION_URL"
JWT_SECRET="generate-a-secure-random-key-here"
JWT_REFRESH_SECRET="generate-another-secure-random-key-here"

# Optional. Enables Redis presence, horizontal Socket.IO scaling and the
# distributed event bus. The server degrades to single-instance mode without it.
REDIS_URL=""

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Gemini drives semantic search, the agent, and all code-aware GitHub features
# (diff review, PR explanation, repo Q&A, proposed edits).
GEMINI_API_KEY="your-google-gemini-api-key"

# Optional fallback used for summaries and smart replies.
GROQ_API_KEY="your-groq-api-key"

# Optional outbound automation target for extracted tasks.
N8N_WEBHOOK_URL=""

# ---------------------------------------------------------------------------
# GitHub integration
# ---------------------------------------------------------------------------
# Where the browser runs. Used as the OAuth redirect origin.
FRONTEND_URL="http://localhost:3000"

# Public HTTPS origin of THIS server. Required only if you want repository
# webhooks (live pull request / push / CI activity in chat) — GitHub must be
# able to reach ${PUBLIC_SERVER_URL}/api/github/webhook/<linkId>.
# Locally, use an ngrok or Cloudflare tunnel URL.
PUBLIC_SERVER_URL=""

# Optional. Register a GitHub OAuth App to offer "Continue with GitHub".
# Set the callback URL to ${FRONTEND_URL}/github/callback.
# Without these, users connect with a personal access token instead —
# no GitHub App registration required.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional. Key used to encrypt stored GitHub tokens and webhook secrets
# (AES-256-GCM). Falls back to JWT_SECRET when unset. Changing it invalidates
# every stored token, forcing users to reconnect.
TOKEN_ENCRYPTION_KEY=""
